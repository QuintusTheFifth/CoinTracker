{
  "name": "coin-tracker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NODE_OPTIONS=--openssl-legacy-provider ng serve --proxy-config proxy.conf.json",
    "build": "NODE_OPTIONS=--openssl-legacy-provider ng build",
    "build:prod": "NODE_OPTIONS=--openssl-legacy-provider ng build --prod",
    "test": "NODE_OPTIONS=--openssl-legacy-provider ng test",
    "test:ci": "NODE_OPTIONS=--openssl-legacy-provider ng test --watch=false",
    "lint": "ng lint",
    "verify": "npm run lint -- --format stylish && npm run build:prod && npm run test:ci && npm run verify:rules && npm run audit:critical",
    "verify:rules": "node scripts/verify-firestore-rules.js",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "e2e": "NODE_OPTIONS=--openssl-legacy-provider ng e2e",
    "postinstall": "node scripts/patch-webpack-dev-middleware.js"
  },
  "private": true,
  "overrides": {
    "@grpc/proto-loader": "0.8.1",
    "protobufjs": "8.5.0",
    "node-fetch": "2.7.0"
  },
  "dependencies": {
    "@angular/animations": "^9.1.4",
    "@angular/cdk": "^9.2.4",
    "@angular/common": "~9.1.1",
    "@angular/compiler": "~9.1.1",
    "@angular/core": "~9.1.1",
    "@angular/flex-layout": "^9.0.0-beta.29",
    "@angular/forms": "~9.1.1",
    "@angular/material": "^9.2.4",
    "@angular/platform-browser": "~9.1.1",
    "@angular/platform-browser-dynamic": "~9.1.1",
    "@angular/router": "~9.1.1",
    "angularfire2": "^5.4.2",
    "bootstrap": "^4.4.1",
    "chart.js": "^2.9.4",
    "firebase": "^7.15.3",
    "font-awesome": "^4.7.0",
    "hammerjs": "^2.0.8",
    "material-design-icons": "^3.0.1",
    "rxjs": "~6.5.4",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/architect": "<0.900 || ^0.900.0-0 || ^9.0.0-0",
    "@angular-devkit/build-angular": "^0.901.9",
    "@angular/cli": "~9.1.1",
    "@angular/compiler-cli": "~9.1.1",
    "@angular/language-service": "~9.1.1",
    "@types/hammerjs": "^2.0.36",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.12.47",
    "codelyzer": "^5.1.2",
    "cypress": "^4.12.1",
    "firebase-tools": "^7.12.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^6.2.2",
    "inquirer-autocomplete-prompt": "^1.0.1",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "protractor": "~5.4.3",
    "puppeteer": "^19.11.1",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~3.8.3"
  }
}
